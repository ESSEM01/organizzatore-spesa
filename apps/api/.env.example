# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
#--------------------------------------------------------------------
# Database (D8). Vuoto = SQLite locale in tmp/db.sqlite3.
# Produzione: DB_CONNECTION=libsql con URL e token del database Turso.
#--------------------------------------------------------------------
# DB_CONNECTION=libsql
# LIBSQL_URL=libsql://<nome-db>-<utente>.turso.io
# LIBSQL_AUTH_TOKEN=

# Claude (D4): lettura dei volantini. Si crea su console.anthropic.com
# ANTHROPIC_API_KEY=

# Controllo settimanale dei volantini nel server (D15). Richiede ANTHROPIC_API_KEY
# CONTROLLO_VOLANTINI=true
LIMITER_STORE=database
MAIL_MAILER=resend
MAIL_FROM_NAME=Organizzatore spesa
MAIL_FROM_ADDRESS=onboarding@resend.dev
RESEND_API_KEY=