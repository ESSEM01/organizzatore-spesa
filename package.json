{
  "name": "organizzatore-spesa",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build -w @spesa/domain && npm run build -w @spesa/web && npm run build -w @spesa/api",
    "test": "npm test --workspaces --if-present",
    "dev:web": "npm run dev -w @spesa/web",
    "dev:api": "npm run dev -w @spesa/api"
  },
  "allowScripts": {
    "@swc/core": true,
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8",
    "glob@>=9.0.0 <=14.0.1": "^14.0.6",
    "nodemailer": "^10.5.0"
  }
}
