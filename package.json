{
  "name": "organizzatore-spesa",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build -w @spesa/domain && npm run build -w @spesa/web && npm run build -w @spesa/api",
    "test": "npm test --workspaces --if-present",
    "dev:web": "npm run dev -w @spesa/web",
    "dev:api": "npm run dev -w @spesa/api"
  },
  "allowScripts": {
    "@swc/core": true,
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true
  }
}
